# Copy this file to .env.local and fill in the values

# Supabase — copy from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — copy from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Upstash Redis — required for rate limiting. Create a free DB at https://upstash.com
# Use the REST API URL and token (not the Redis connection string)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
