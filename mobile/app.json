{
  "expo": {
    "name": "OrderPing",
    "slug": "orderping",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "orderping",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A56E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orderping.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A56E8"
      },
      "package": "com.orderping.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8e3b2d1-088e-42cf-a19f-5fcfdf7fc72e"
      }
    },
    "owner": "mbalisto"
  }
}
